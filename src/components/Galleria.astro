---
// Galleria v3: due marquee contrapposti + foto vive (Ken Burns) intercalate
const rigaA = [
  '/photos/interno-1.jpg',
  '/photos/menu-dip.jpg',
  '/photos/bao-croccanti.jpg',
  '/photos/broll-2.png',
  '/photos/interno-3.jpg',
  '/photos/menu-noodles.jpg',
]
const rigaB = [
  '/photos/takeaway-borsa.jpg',
  '/photos/ravioli-sfoglia-nera.jpg',
  '/photos/broll-1.png',
  '/photos/interno-4.jpg',
  '/photos/menu-bao-aperto.jpg',
  '/photos/menu-te.jpg',
]
---

<section id="galleria" class="overflow-hidden bg-antracite py-24">
  <p class="mb-12 px-6 text-center text-xs uppercase tracking-[0.4em] text-ambra">Dalla nostra cucina</p>

  <div class="marquee-track flex w-max gap-5 will-change-transform" data-marquee data-skew>
    {
      [...rigaA, ...rigaA].map((src) => (
        <figure class="lens group relative h-[260px] w-[340px] shrink-0 overflow-hidden rounded-sm sm:h-[300px] sm:w-[400px]">
          <img src={src} alt="Bottega N.8 — piatto e atmosfera" class="h-full w-full object-cover transition-all duration-[900ms] ease-out group-hover:scale-110" loading="lazy" draggable="false" />
          <div class="lens-ring pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100">
            <div class="absolute inset-6 rounded-full border border-crema/50 backdrop-brightness-[1.15]" />
          </div>
        </figure>
      ))
    }
  </div>

  <div class="marquee-track-rev mt-5 flex w-max gap-5 will-change-transform" data-marquee-rev data-skew>
    {
      [...rigaB, ...rigaB].map((src) => (
        <figure class={`group relative h-[260px] w-[340px] shrink-0 overflow-hidden rounded-sm sm:h-[300px] sm:w-[400px]`}>
          <img src={src} alt="Bottega N.8 — piatto e atmosfera" class="h-full w-full object-cover transition-all duration-[900ms] ease-out group-hover:scale-110" loading="lazy" draggable="false" />
          <figcaption class="absolute inset-x-0 bottom-0 translate-y-full bg-gradient-to-t from-antracite/90 to-transparent p-4 text-xs uppercase tracking-[0.25em] text-crema/80 transition-transform duration-500 group-hover:translate-y-0">
            Bottega N.8
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>

<script>
  window.addEventListener('site:ready', () => {
    const gsap = (window as any).gsap
    const ScrollTrigger = (window as any).ScrollTrigger
    const reduced = (window as any).__reduced
    if (reduced) return

    const makeMarquee = (sel: string, dir = 1, dur = 55) => {
      const track = document.querySelector(sel) as HTMLElement
      if (!track) return null
      const half = () => track.scrollWidth / 2
      const tween = gsap.to(track, {
        x: -half() * dir,
        duration: dur,
        ease: 'none',
        repeat: -1,
        modifiers: {
          x: (x: number) => {
            const h = track.scrollWidth / 2
            return String(dir > 0 ? gsap.utils.wrap(-h, 0, x) : gsap.utils.wrap(0, h, x))
          },
        },
      })
      track.querySelectorAll('figure').forEach((f) => {
        f.addEventListener('mouseenter', () => gsap.to(tween, { timeScale: 0.1, duration: 0.4 }))
        f.addEventListener('mouseleave', () => gsap.to(tween, { timeScale: 1, duration: 0.6 }))
      })
      ScrollTrigger.create({
        trigger: '#galleria',
        start: 'top bottom',
        end: 'bottom top',
        onToggle: (self: any) => tween.paused(!self.isActive),
      })
      return tween
    }

    // la seconda riga reagisce alla velocità dello scroll: accelera quando scendi veloce
    const rev = makeMarquee('[data-marquee-rev]', -1, 62)
    if (rev) {
      let boostST = ScrollTrigger.create({
        onUpdate: (self: any) => {
          const v = Math.min(4, Math.abs(self.getVelocity()) / 800)
          gsap.to(rev, { timeScale: 1 + v, duration: 0.3, overwrite: 'auto' })
        },
      })
    }

    makeMarquee('[data-marquee]', 1, 55)
  })
</script>
