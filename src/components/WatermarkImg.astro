---
// WatermarkImg — <img> con overlay segnaposto "DA SOSTITUIRE".
// Usato su tutte le foto che NON sono interni reali del locale
// (piatti, chef, stock generici) per marcare cosa andrà rimpiazzato
// con foto ufficiali del ristorante.
interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: string;
  decoding?: string;
}
const { src, alt, class: cls = '', loading = 'lazy', decoding = 'async' } = Astro.props;
---
<figure class={`watermark-wrap relative overflow-hidden ${cls}`}>
  <img src={src} alt={alt} loading={loading} decoding={decoding} class="h-full w-full object-cover" />
  <img
    src="/photos/watermark-badge.png"
    alt=""
    aria-hidden="true"
    class="watermark-badge pointer-events-none absolute left-3 top-3 z-20 w-28 max-w-[40%] drop-shadow-lg md:w-32"
  />
</figure>

<style>
  .watermark-wrap { display: block; }
  /* il badge non deve mai coprire l'intera immagine */
  .watermark-badge { opacity: 0.92; }
</style>
