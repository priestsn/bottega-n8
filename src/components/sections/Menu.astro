---
const piatti = [
  {
    name: 'Ravioli allo zenzero',
    desc: 'Ombrina o bovino. I più citati nelle recensioni.',
    img: '/photos/menu-ravioli-classic.jpg',
    tag: 'best seller',
  },
  {
    name: 'Ravioli ai gamberi',
    desc: 'Ripieno di gambero, preparati a mano ogni giorno.',
    img: '/photos/menu-gamberi.jpg',
  },
  {
    name: 'Bao al manzo',
    desc: 'Morbididi fuori, croccanti dentro. Cavolo fermentato cinese.',
    img: '/photos/menu-bao.jpg',
    tag: 'firma',
  },
  {
    name: 'Ramen',
    desc: 'Brodo di mare, spaghetti freschi, la nostra firma più richiesta.',
    img: '/photos/menu-ramen.jpg',
  },
  {
    name: 'Sfoglia nera',
    desc: 'Ravioli con pasta al nero di seppia. La nostra versione più fotografata.',
    img: '/photos/ravioli-sfoglia-nera.jpg',
  },
  {
    name: 'Noodles saltati',
    desc: 'Spaghetti freschi, wok bollente, verdure croccanti.',
    img: '/photos/menu-noodles.jpg',
  },
]
---

<section id="menu" class="bg-antracite">
  <!-- desktop: interactive drag + scroll horizontal gallery -->
  <div class="menu-desktop relative hidden lg:block" data-menu-desktop>
    <div class="flex h-[100svh] flex-col justify-center overflow-hidden">
      <div class="mb-8 flex items-end justify-between px-16">
        <div>
          <p class="text-xs uppercase tracking-[0.4em] text-ambra">Il menu</p>
          <h2 class="mt-2 font-display text-5xl uppercase text-crema">Alcuni dei nostri piatti</h2>
        </div>
        <p class="text-xs uppercase tracking-[0.3em] text-crema/40">trascina o scorri →</p>
      </div>
      <div class="menu-track flex cursor-grab gap-12 px-16 will-change-transform active:cursor-grabbing" data-menu-track>
        {
          piatti.map((p, i) => (
            <article class={`dish-card group relative w-[440px] shrink-0 select-none ${i % 2 ? 'mt-20' : ''}`} data-draggable>
              <span class="absolute -top-3 left-4 z-10 bg-ambra px-3 py-1 text-[10px] font-medium uppercase tracking-[0.25em] text-antracite opacity-0 transition-opacity duration-300 group-hover:opacity-100">{p.tag}</span>
              <div class="overflow-hidden rounded-sm shadow-2xl">
                <img
                  src={p.img}
                  alt={p.name}
                  class="h-[400px] w-full object-cover transition-all duration-[900ms] ease-out group-hover:scale-[1.06]"
                  loading="lazy"
                  draggable="false"
                />
              </div>
              <h3 class="mt-6 font-display text-3xl uppercase tracking-wide text-crema transition-colors duration-300 group-hover:text-ambra">{p.name}</h3>
              <p class="mt-2 max-w-xs text-sm leading-relaxed text-crema/60">{p.desc}</p>
            </article>
          ))
        }
      </div>
      <div class="mt-10 px-16">
        <div class="menu-progress h-px w-full bg-crema/15"><div class="menu-progress-fill h-full origin-left scale-x-0 bg-ambra"></div></div>
      </div>
    </div>
  </div>

  <!-- mobile: swipeable snap carousel -->
  <div class="py-20 lg:hidden">
    <div class="px-6">
      <p class="text-xs uppercase tracking-[0.4em] text-ambra">Il menu</p>
      <h2 class="mt-2 font-display text-4xl uppercase text-crema">Alcuni dei nostri piatti</h2>
    </div>
    <div class="menu-swipe mt-10 flex snap-x snap-mandatory gap-6 overflow-x-auto px-6 pb-4 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {
        piatti.map((p) => (
          <article class="w-[80vw] shrink-0 snap-center">
            <img src={p.img} alt={p.name} class="aspect-[4/5] w-full rounded-sm object-cover" loading="lazy" draggable="false" />
            <h3 class="mt-4 font-display text-2xl uppercase text-crema">{p.name}</h3>
            <p class="mt-1 text-sm text-crema/60">{p.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  window.addEventListener('site:ready', () => {
    const gsap = (window as any).gsap
    const ScrollTrigger = (window as any).ScrollTrigger
    const reduced = (window as any).__reduced
    if (reduced) return

    // desktop: scroll-driven horizontal pan + drag interaction + progress bar
    const mm = gsap.matchMedia()
    mm.add('(min-width: 1024px)', () => {
      const track = document.querySelector('[data-menu-track]') as HTMLElement
      if (!track) return

      const distance = () => Math.max(0, track.scrollWidth - window.innerWidth + 128)
      const tween = gsap.to(track, {
        x: () => -distance(),
        ease: 'none',
        scrollTrigger: {
          trigger: '[data-menu-desktop]',
          start: 'top top',
          end: () => `+=${distance()}`,
          pin: true,
          scrub: 1,
          anticipatePin: 1,
          invalidateOnRefresh: true,
          onUpdate: (self: any) => {
            gsap.set('.menu-progress-fill', { scaleX: self.progress })
          },
        },
      })

      // drag to explore (adds velocity, feels physical)
      let isDown = false, startX = 0, startScroll = 0
      const st = tween.scrollTrigger!
      track.addEventListener('pointerdown', (e) => {
        isDown = true; startX = e.clientX; startScroll = st.scroll ?? window.scrollY
      })
      window.addEventListener('pointermove', (e) => {
        if (!isDown) return
        const delta = e.clientX - startX
        if (Math.abs(delta) > 4) {
          const lenis = (window as any).lenis
          const target = startScroll - delta * (distance() / window.innerWidth) * 1.2
          if (lenis) lenis.scrollTo(target, { immediate: true })
          else window.scrollTo(0, target)
        }
      })
      window.addEventListener('pointerup', () => (isDown = false))

      document.querySelectorAll('[data-menu-desktop] img').forEach((img) => {
        if (!(img as HTMLImageElement).complete)
          ;(img as HTMLImageElement).addEventListener('load', () => ScrollTrigger.refresh(), { once: true })
      })
    })
  })
</script>
