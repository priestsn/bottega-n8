---
// Menu interattivo — categorie con foto dei piatti reali.
// Modello a tab: l'utente sceglie una categoria, le card dei piatti si animano.
// Piatti e categorie dal pieghevole ufficiale, foto reali dal locale.
interface Props { id?: string; }
const { id = 'menu' } = Astro.props;

const categories = [
  {
    id: 'ravioli',
    label: 'Ravioli al vapore',
    dishes: [
      { name: 'Xiaolongbao', desc: 'Ravioli cinesi al vapore con brodino caldo all’interno.', img: '/photos/real-xiaolongbao-1.jpg' },
      { name: 'Ravioli di ombrina', desc: 'Sottile sfoglia e ripieno delicato di ombrina, cotti al vapore.', img: '/photos/ravioli-xlb-detail.jpg' },
      { name: 'Ravioli di bovino allo zenzero', desc: 'Ripieno saporito con nota fresca di zenzero.', img: '/photos/ravioli-xlb.jpg' },
    ],
  },
  {
    id: 'noodles',
    label: 'Noodles & Ramen',
    dishes: [
      { name: 'Zha Jiang Mian', desc: 'Noodles conditi con salsa di soia fermentata e verdure.', img: '/photos/ig-noodles.jpg' },
      { name: 'Ramen di mare', desc: 'Brodo intenso e sapori del mare, cucinato a regola d’arte.', img: '/photos/real-ramen-1.jpg' },
      { name: 'Pho', desc: 'Spaghetti di riso vietnamiti in un brodo profumato di manzo.', img: '/photos/real-ramen-2.jpg' },
    ],
  },
  {
    id: 'dimsum',
    label: 'Dim Sum & Bao',
    dishes: [
      { name: 'Siumay Hong-Kong', desc: 'Ravioli aperti in stile cantonese, un classico della casa.', img: '/photos/real-dimsum-1.jpg' },
      { name: 'Dim sum della casa', desc: 'Selezione di dim sum artigianali, serviti al vapore.', img: '/photos/ig-dimsum-vino.jpg' },
      { name: 'Bao con cavolo fermentato', desc: 'Panino soffice al vapore con cavolo fermentato.', img: '/photos/real-bao.jpg' },
    ],
  },
];
const active = categories[0].id;
---

<section id={id} class="relative w-full overflow-hidden bg-antracite py-24 md:py-32" data-st-section>
  <div class="mx-auto max-w-7xl px-6">
    <div class="text-center">
      <span class="font-poppins text-xs uppercase tracking-[0.3em] text-ambra" data-reveal>Il nostro menù</span>
      <h2 class="mt-4 font-anton text-[clamp(2.4rem,7vw,5rem)] uppercase text-crema" data-split>Dal vapore alla tavola</h2>
      <p class="mx-auto mt-6 max-w-2xl font-poppins text-[clamp(1rem,2.5vw,1.2rem)] leading-relaxed text-crema/60" data-reveal data-delay="0.2">
        Ogni piatto nasce al vapore e arriva in tavola fumante. Scegli una categoria.
      </p>
    </div>

    <!-- Tabs -->
    <div class="mt-12 flex flex-wrap items-center justify-center gap-3" role="tablist" aria-label="Categorie del menù" data-reveal data-delay="0.3">
      {categories.map((c, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${c.id}`}
          aria-controls={`panel-${c.id}`}
          aria-selected={active === c.id ? 'true' : 'false'}
          data-menu-tab={c.id}
          data-active={active === c.id ? 'true' : 'false'}
          class="menu-tab touch-target rounded-full border px-6 py-3 font-poppins text-sm font-medium uppercase tracking-wider transition-all duration-300"
        >
          {c.label}
        </button>
      ))}
    </div>

    <!-- Panels -->
    {categories.map((c) => (
      <div
        id={`panel-${c.id}`}
        role="tabpanel"
        aria-labelledby={`tab-${c.id}`}
        data-menu-panel={c.id}
        data-active={active === c.id ? 'true' : 'false'}
        class="menu-panel mt-12"
      >
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {c.dishes.map((d, i) => (
            <article class="group relative overflow-hidden rounded-2xl" data-menu-dish>
              <div class="relative aspect-[4/5] overflow-hidden">
                <img
                  src={d.img}
                  alt={d.name}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-nero/85 via-nero/20 to-transparent" aria-hidden="true"></div>
                <div class="absolute inset-x-0 bottom-0 p-6">
                  <h3 class="font-anton text-2xl uppercase leading-tight text-crema md:text-3xl">{d.name}</h3>
                  <p class="mt-2 font-poppins text-sm leading-relaxed text-crema/70">{d.desc}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style is:global>
  .menu-tab {
    color: #F8EADB;
    border-color: rgba(248, 234, 219, 0.2);
    background: transparent;
  }
  .menu-tab:hover {
    border-color: rgba(219, 147, 74, 0.6);
    color: #DB934A;
  }
  .menu-tab[data-active="true"] {
    background: #DB934A;
    border-color: #DB934A;
    color: #222228;
  }
  .menu-panel[data-active="false"] {
    display: none;
  }
</style>

<script>
  // Tabs menu — mostra/nasconde i pannelli e anima le card con GSAP.
  (function () {
    const tabs = document.querySelectorAll('[data-menu-tab]');
    const panels = document.querySelectorAll('[data-menu-panel]');
    if (!tabs.length) return;

    function activate(id) {
      tabs.forEach((t) => {
        const on = t.dataset.menuTab === id;
        t.dataset.active = String(on);
        t.setAttribute('aria-selected', String(on));
      });
      panels.forEach((p) => {
        const on = p.dataset.menuPanel === id;
        p.dataset.active = String(on);
        if (on) {
          // anima le card del pannello attivo
          const cards = p.querySelectorAll('[data-menu-dish]');
          if (window.gsap && !window.__reduced) {
            gsap.fromTo(cards, { opacity: 0, y: 30 }, {
              opacity: 1, y: 0, duration: 0.6, stagger: 0.08, ease: 'power3.out',
            });
          } else {
            cards.forEach((c) => (c.style.opacity = 1));
          }
        }
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => activate(tab.dataset.menuTab));
    });
  })();
</script>
