---
// Filosofia: manifesto — una parola enorme per volta, pinned, con la foto ravioli che scorre
---

<section id="filosofia" class="relative bg-antracite">
  <div class="filosofia-stage relative flex h-[100svh] items-center justify-center overflow-hidden" data-filosofia>
    <video
      src="/photos/video-vaporiera.mp4"
      alt="Vapore dalla vaporiera — Bottega N.8"
      class="absolute inset-0 h-full w-full object-cover opacity-30"
      autoplay muted loop playsinline preload="metadata"
      data-filosofia-img
    ></video>
    <div class="absolute inset-0 bg-gradient-to-b from-antracite via-transparent to-antracite"></div>

    <div class="relative z-10 w-full text-center">
      {
        ['equilibrio', 'autenticità', 'armonia', 'creatività'].map((w, i) => (
          <h2
            class={`filo-word absolute inset-x-0 top-1/2 -translate-y-1/2 font-display uppercase text-crema ${i === 3 ? 'text-ambra' : ''}`}
            style={`font-size: clamp(2.4rem, ${w.length > 10 ? '9vw' : '13vw'}, 8rem);`}
            data-filo-word
            data-filo-offset={i}
          >
            {w}
          </h2>
        ))
      }
      <p class="filo-intro absolute inset-x-0 bottom-[7%] mx-auto max-w-md px-8 text-sm leading-relaxed tracking-wide text-crema/70" data-filo-intro style="opacity: 0">
        Ogni proposta racconta un incontro tra culture, esperienze e sapori.
      </p>
    </div>

    <div class="filo-dots absolute bottom-10 left-1/2 z-10 flex -translate-x-1/2 gap-2">
      {[0, 1, 2, 3].map((i) => (
        <span class="filo-dot h-1.5 w-1.5 rounded-full bg-crema/30" data-dot={i} />
      ))}
    </div>
  </div>

  <!-- fallback mobile / reduced: static stack -->
  <noscript>
    <div class="px-6 py-20 text-center">
      {['equilibrio', 'autenticità', 'armonia', 'creatività'].map((w) => (
        <p class="font-display text-4xl uppercase text-crema">{w}</p>
      ))}
    </div>
  </noscript>
</section>

<style>
  [data-filo-word]:not(:first-of-type) {
    opacity: 0;
  }
</style>

<script>
  window.addEventListener('site:ready', () => {
    const gsap = (window as any).gsap
    const ScrollTrigger = (window as any).ScrollTrigger
    const reduced = (window as any).__reduced
    const words = document.querySelectorAll('[data-filo-word]')
    const dots = document.querySelectorAll('.filo-dot')
    const stage = document.querySelector('[data-filosofia]') as HTMLElement

    // reduced motion or no JS: show all stacked statically
    if (reduced || !words.length) {
      stage?.style.setProperty('height', 'auto')
      words.forEach((w, i) => {
        const el = w as HTMLElement
        el.style.position = 'static'
        el.style.opacity = '1'
        el.style.transform = 'none'
        if (i > 0) el.style.marginTop = '1rem'
      })
      document.querySelector('[data-filo-intro]')?.setAttribute('style', 'position:static; margin-top:2rem')
      return
    }

    // pinned word sequence: one giant word at a time, scrubbed by scroll
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '[data-filosofia]',
        start: 'top top',
        end: '+=300%',
        pin: true,
        scrub: 0.6,
        onUpdate: (self: any) => {
          const idx = Math.min(3, Math.floor(self.progress * 4))
          dots.forEach((d, i) => {
            ;(d as HTMLElement).classList.toggle('!bg-ambra', i <= idx)
          })
        },
      },
    })

    gsap.set('[data-filo-word]', { opacity: 0, scale: 0.92, filter: 'blur(8px)', yPercent: -50 })
    tl.to(words[0], { opacity: 1, scale: 1, filter: 'blur(0px)', duration: 1 }, 0)
    for (let i = 1; i < words.length; i++) {
      tl.to(words[i - 1], { opacity: 0, scale: 1.06, filter: 'blur(6px)', duration: 0.7 }, i * 2)
      tl.fromTo(words[i], { opacity: 0, scale: 0.92, filter: 'blur(8px)' }, { opacity: 1, scale: 1, filter: 'blur(0px)', duration: 0.7 }, i * 2 + 0.5)
    }
    tl.fromTo('[data-filo-intro]', { opacity: 0 }, { opacity: 1, duration: 0.6 }, words.length * 2 - 0.5)
    // l'ultima parola esce quando arriva l'intro: niente sovrapposizione
    tl.to(words[words.length - 1], { opacity: 0, scale: 1.06, filter: 'blur(6px)', duration: 0.6 }, words.length * 2 - 0.5)

    // subtle parallax on the backdrop photo
    gsap.to('[data-filosofia-img]', {
      yPercent: -10,
      ease: 'none',
      scrollTrigger: { trigger: '[data-filosofia]', start: 'top bottom', end: 'bottom top', scrub: true },
    })
  })
</script>
