---
interface Props { id?: string; }
const { id = 'filosofia' } = Astro.props;
const keywords = ['equilibrio', 'autenticità', 'armonia', 'creatività'];
---

<section id={id} class="relative w-full overflow-hidden bg-antracite py-16 md:py-20" data-st-section>
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(219,147,74,0.07)_0%,transparent_70%)]" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto w-full max-w-5xl px-6">
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-[auto_1fr] lg:gap-14">
      <!-- Etichetta compatta -->
      <div class="flex items-center gap-3 lg:flex-col lg:items-start">
        <span class="inline-flex items-center gap-3 font-poppins text-xs uppercase tracking-[0.3em] text-ambra" data-reveal>
          <span class="h-px w-10 bg-ambra"></span> La nostra filosofia
        </span>
      </div>

      <!-- Parole chiave inline, fascia compatta -->
      <div class="flex flex-wrap items-center gap-x-8 gap-y-3 lg:justify-end" data-reveal data-delay="0.15">
        {keywords.map((k, i) => (
          <span class="keyword-chip group flex items-center gap-3">
            <span class="font-anton text-[clamp(1.6rem,4.5vw,2.6rem)] uppercase leading-none tracking-wide text-crema transition-colors duration-300 group-hover:text-ambra" data-keyword-word>{k}</span>
            {i < keywords.length - 1 && <span class="text-ambra/50" aria-hidden="true">·</span>}
          </span>
        ))}
      </div>
    </div>

    <p class="mt-8 max-w-3xl font-poppins text-base leading-relaxed text-crema/55 md:text-lg" data-reveal data-delay="0.2">
      L'incontro tra culture, esperienze e sapori: una cucina personale, contemporanea e sorprendentemente vicina.
    </p>
  </div>
</section>

<script is:inline>
  // Flip 3D lettera per lettera sulle parole chiave (compatto, una sola riga).
  window.addEventListener('site:ready', () => {
    const words = document.querySelectorAll('[data-keyword-word]');
    // Fallback: con reduced-motion o senza GSAP le parole restano VISIBILI
    if (window.__reduced || !window.gsap) {
      words.forEach((el) => { el.style.opacity = '1'; });
      return;
    }
    const gsap = window.gsap;
    words.forEach((el, idx) => {
      const text = el.textContent || '';
      el.setAttribute('aria-label', text);
      el.innerHTML = text.split('').map((c) =>
        `<span class="inline-block will-change-transform" style="display:inline-block;transform:rotateX(-90deg);transform-origin:center bottom;opacity:0;">${c === ' ' ? '&nbsp;' : c}</span>`
      ).join('');
      const spans = el.querySelectorAll('span');
      gsap.to(spans, {
        rotateX: 0, opacity: 1,
        duration: 0.6, stagger: 0.03, ease: 'back.out(1.3)',
        delay: idx * 0.08,
        scrollTrigger: { trigger: el, start: 'top 88%', once: true },
      });
    });
  });
</script>
