---
// Stampa v3: recensioni in marquee verticale a colonne alternate + quote gigante
const recensioni = [
  {
    source: 'Italia a Tavola',
    text: 'La cucina asiatica contemporanea di stampo cinese che Bergamo aspettava: tecnica, ingredienti scelti, visione personale.',
    year: 'Nov 2025',
  },
  {
    source: 'QUI Bergamo',
    text: 'Un incontro generazionale e familiare tra due mondi, raccontato a tavola. Lontani dagli all you can eat.',
    year: 'Nov 2025',
  },
  {
    source: 'Google Reviews',
    text: '4,8 stelle su 61 recensioni. I ravioli sono i più citati della città.',
    year: '2026',
  },
]
---

<section id="stampa" class="overflow-hidden bg-antracite py-24 md:py-32">
  <p class="mb-14 px-6 text-center text-xs uppercase tracking-[0.4em] text-ambra">Dicono di noi</p>

  <!-- quote gigante che scala con lo scroll -->
  <blockquote class="mx-auto mb-20 max-w-4xl px-6 text-center">
    <p class="font-display text-3xl uppercase leading-tight text-crema sm:text-5xl lg:text-6xl" data-chars>
      I ravioli più citati della città
    </p>
    <cite class="mt-6 block text-[11px] uppercase not-italic tracking-[0.3em] text-crema/50">— Google Reviews, 4,8★ su 61</cite>
  </blockquote>

  <div class="grid grid-cols-1 gap-8 px-6 md:grid-cols-3 md:px-16" data-reveal-group>
    {
      recensioni.map((r) => (
        <figure
          class="stampa-card relative border border-crema/10 bg-white/[0.03] p-8 transition-all duration-500 hover:-translate-y-2 hover:border-ambra/40 hover:bg-white/[0.06]"
          data-reveal
        >
          <span class="absolute -top-1 left-6 font-display text-7xl leading-none text-ambra">“</span>
          <blockquote class="mt-6 text-sm leading-relaxed text-crema/85">{r.text}</blockquote>
          <figcaption class="mt-6 flex items-center justify-between text-[11px] uppercase tracking-[0.25em] text-crema/50">
            <span>{r.source}</span>
            <span class="text-ambra/70">{r.year}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
