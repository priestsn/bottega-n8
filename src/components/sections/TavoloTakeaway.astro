---
// Tavolo v3: split-screen pinned — tavolo vs take away, la scelta si "taglia" con lo scroll
---

<section id="tavolo" class="relative bg-crema text-antracite">
  <div class="tavolo-stage relative flex h-[100svh] overflow-hidden" data-tavolo>
    <!-- metà sinistra: tavolo -->
    <div class="tavolo-half absolute inset-y-0 left-0 w-full overflow-hidden" data-half="tavolo">
      <img src="/photos/interno-2.jpg" alt="La sala di Bottega N.8" class="h-full w-full object-cover" loading="lazy" data-living />
      <div class="absolute inset-0 bg-antracite/55"></div>
      <div class="absolute inset-0 flex flex-col items-center justify-center px-8 text-center text-crema">
        <p class="text-xs uppercase tracking-[0.4em] text-ambra">Sera</p>
        <h3 class="mt-3 font-display text-5xl uppercase sm:text-7xl" data-chars>Al tavolo</h3>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-crema/80">
          Cena lenta da condividere. Ravioli fatti a mano, piatti che arrivano quando sono pronti.
        </p>
        <a href="tel:+390****7334" class="magnetic mt-8 bg-ambra px-8 py-3 font-display text-xs uppercase tracking-[0.25em] text-antracite transition-transform duration-300">
          035 297 334
        </a>
      </div>
    </div>
    <!-- metà destra: take away (slide-in sopra) -->
    <div class="tavolo-half absolute inset-y-0 right-0 w-1/2 overflow-hidden" data-half="takeaway">
    <img
      src="/photos/takeaway-borsa.jpg"
      alt="Sacchetto take away Bottega N.8"
      class="h-full w-full object-cover"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-antracite/45"></div>
      <div class="absolute inset-0 flex flex-col items-center justify-center px-8 text-center text-crema">
        <p class="text-xs uppercase tracking-[0.4em] text-ambra">Pausa</p>
        <h3 class="mt-3 font-display text-5xl uppercase sm:text-7xl" data-chars>Take away</h3>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-crema/80">
          La stessa cura, da portare via. Su Deliveroo e Glovo, o direttamente in bottega.
        </p>
        <span class="mt-8 border border-crema/40 px-8 py-3 font-display text-xs uppercase tracking-[0.25em] text-crema">
          Deliveroo · Glovo
        </span>
      </div>
    </div>

    <p class="absolute bottom-6 left-1/2 z-10 hidden -translate-x-1/2 whitespace-nowrap font-display text-lg uppercase tracking-[0.25em] text-crema/90 mix-blend-difference md:block">
      La stessa cura, in ogni piatto.
    </p>
  </div>
</section>

<script>
  window.addEventListener('site:ready', () => {
    const gsap = (window as any).gsap
    const ScrollTrigger = (window as any).ScrollTrigger
    const reduced = (window as any).__reduced
    if (reduced) return

    const mm = gsap.matchMedia()
    mm.add('(min-width: 768px)', () => {
      // takeaway entra coprendo metà schermo, poi entrambe le metà si restringono a "portale"
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: '[data-tavolo]',
          start: 'top top',
          end: '+=160%',
          pin: true,
          scrub: 0.8,
          anticipatePin: 1,
        },
      })
      tl.fromTo('[data-half="takeaway"]', { width: '100%' }, { width: '50%', duration: 1, ease: 'power2.inOut' }, 0)
        .fromTo('[data-half="takeaway"]', { clipPath: 'inset(0 0 0 100%)' }, { clipPath: 'inset(0 0 0 0%)', duration: 1, ease: 'power2.inOut' }, 0)
    })

    // mobile: semplice stack
    mm.add('(max-width: 767px)', () => {
      gsap.set('[data-half="takeaway"]', { position: 'relative', width: '100%', height: '100svh', clipPath: 'none' })
      gsap.set('[data-half="tavolo"]', { position: 'relative', height: '100svh' })
      gsap.set('.tavolo-stage', { display: 'block', height: 'auto' })
    })
  })
</script>
