---
interface Props { id?: string; }
const { id = 'dove-siamo' } = Astro.props;
---

<section id={id} class="relative w-full overflow-hidden bg-antracite py-24 md:py-32" data-st-section>

  <div class="relative z-10 mx-auto w-full max-w-7xl px-6">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Map -->
      <div class="relative overflow-hidden rounded-3xl" data-reveal>
        <iframe
          title="Posizione di Bottega N.8 su Google Maps — Via Clara Maffei 8, Bergamo"
          src="https://www.google.com/maps?q=Via+Clara+Maffei+8,+24121+Bergamo&output=embed&z=16"
          class="aspect-[4/3] w-full border-0"
          style="filter: sepia(0.35) saturate(0.7) contrast(1.05) hue-rotate(-8deg);"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <a
          href="https://www.google.com/maps/search/?api=1&query=Via+Clara+Maffei+8,+24121+Bergamo"
          target="_blank"
          rel="noopener noreferrer"
          class="absolute bottom-4 right-4 touch-target inline-flex items-center rounded-full bg-crema px-5 py-2.5 font-poppins text-sm font-medium text-antracite shadow-lg transition-colors hover:bg-white"
        >Apri in Google Maps</a>
      </div>

      <!-- Info -->
      <div>
        <span class="font-poppins text-xs uppercase tracking-[0.3em] text-ambra" data-reveal>Dove siamo</span>
        <h2 class="mt-4 font-anton text-[clamp(2.2rem,6vw,4.5rem)] uppercase text-crema" data-reveal data-delay="0.1">Nel cuore di Bergamo</h2>

        <dl class="mt-10 space-y-8">
          <div data-reveal data-delay="0.2">
            <dt class="font-poppins text-xs uppercase tracking-[0.3em] text-ambra">Indirizzo</dt>
            <dd class="mt-2 font-poppins text-xl leading-relaxed text-crema">Via Clara Maffei, 8<br />24121 Bergamo (BG)</dd>
          </div>

          <div data-reveal data-delay="0.3">
            <dt class="font-poppins text-xs uppercase tracking-[0.3em] text-ambra">Telefono</dt>
            <dd class="mt-2">
              <a href="tel:035297334" class="touch-target inline-block font-poppins text-xl text-crema underline-offset-4 hover:text-ambra hover:underline">035 297 334</a>
            </dd>
          </div>

          <div data-reveal data-delay="0.4">
            <dt class="font-poppins text-xs uppercase tracking-[0.3em] text-ambra">Social</dt>
            <dd class="mt-2">
              <a href="https://www.instagram.com/bottegan8/" target="_blank" rel="noopener noreferrer" class="touch-target inline-flex items-center gap-2 font-poppins text-xl text-crema hover:text-ambra">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                @bottegan8
              </a>
            </dd>
          </div>

          <div data-reveal data-delay="0.5">
            <dt class="font-poppins text-xs uppercase tracking-[0.3em] text-ambra">Orari</dt>
            <dd class="mt-2 font-poppins text-xl text-crema/70">Apre la sera · chiama per la prenotazione</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>
