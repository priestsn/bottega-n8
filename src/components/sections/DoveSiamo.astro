---
// DoveSiamo v3: video dell'ingresso del locale come sfondo, info in overlay
---

<section id="dove-siamo" class="relative overflow-hidden bg-antracite text-crema">
  <!-- video ingresso -->
  <video
    class="absolute inset-0 h-full w-full object-cover opacity-45"
    src="/photos/video-ingresso.mp4"
    autoplay muted loop playsinline preload="metadata"
  ></video>
  <div class="absolute inset-0 bg-gradient-to-r from-antracite via-antracite/70 to-antracite/30"></div>

  <div class="relative z-10 mx-auto grid max-w-6xl grid-cols-1 gap-12 px-6 py-28 md:grid-cols-2 md:py-40" data-reveal-group>
    <div>
      <p class="mb-3 text-xs uppercase tracking-[0.4em] text-ambra">Dove siamo</p>
      <h2 class="font-display text-4xl uppercase leading-tight sm:text-5xl" data-chars>Via Clara Maffei 8, Bergamo</h2>
      <p class="mt-6 max-w-md text-sm leading-relaxed text-crema/75">
        Nel cuore di Bergamo Alta, a due passi dal teatro. Cerca la porta con l'otto:
        dentro c'è il profumo di vapore e zenzero.
      </p>
      <a
        href="https://maps.google.com/?q=Via+Clara+Maffei+8+Bergamo"
        target="_blank"
        rel="noopener"
        class="magnetic mt-8 inline-block border border-crema/40 px-8 py-3 font-display text-xs uppercase tracking-[0.25em] transition-colors duration-300 hover:border-ambra hover:text-ambra"
      >
        Apri in Maps
      </a>
    </div>

    <!-- mappa integrata: card con angoli arrotondati, bordo ambra, filtra il tema scuro -->
    <div class="relative overflow-hidden rounded-sm border border-ambra/30 shadow-2xl md:col-span-2" data-reveal>
      <iframe
        class="h-[320px] w-full sm:h-[420px]"
        src="https://www.google.com/maps?q=Via%20Clara%20Maffei%208%2C%2024121%20Bergamo&z=17&output=embed"
        style="border: 0; filter: grayscale(0.4) contrast(1.05);"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Mappa — Bottega N.8, Via Clara Maffei 8, Bergamo"
        aria-label="Mappa di Bottega N.8 - Via Clara Maffei 8, Bergamo"
      ></iframe>
    </div>

    <div class="flex flex-col justify-center gap-6">
      <div class="border-l-2 border-ambra pl-5">
        <p class="font-display text-xl uppercase">Orari</p>
        <p class="mt-1 text-sm text-crema/70">Martedì — Domenica · cena dalle 19:15</p>
      </div>
      <div class="border-l-2 border-ambra pl-5">
        <p class="font-display text-xl uppercase">Prenotazioni</p>
        <a href="tel:+390****7334" class="mt-1 block text-sm text-crema/70 transition-colors hover:text-ambra">035 297 334</a>
      </div>
      <div class="border-l-2 border-ambra pl-5">
        <p class="font-display text-xl uppercase">Take away</p>
        <p class="mt-1 text-sm text-crema/70">Deliveroo · Glovo · asporto in bottega</p>
      </div>
    </div>
  </div>
</section>
