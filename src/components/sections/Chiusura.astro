---
---

<section id="chiusura" class="relative bg-antracite">
  <div class="mx-auto flex min-h-[80svh] max-w-4xl flex-col items-center justify-center px-6 py-28 text-center" data-reveal-group>
    <svg class="infinity-svg mb-10 h-20 w-auto sm:h-24" viewBox="0 0 200 100" fill="none" aria-hidden="true">
      <!-- lemniscata simmetrica: due cubiche speculari perfette, si chiude su se stessa -->
      <path
        class="infinity-path"
        d="M100 50 C100 22, 64 22, 50 50 C36 78, 72 78, 100 50 C128 22, 164 22, 150 50 C136 78, 100 78, 100 50 Z"
        stroke="#DB934A"
        stroke-width="3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>

    <h2 class="font-display text-4xl uppercase leading-tight text-crema sm:text-6xl" data-blur data-reveal>
      Autentica · Curata · Contemporanea
    </h2>
    <p class="mt-6 max-w-md text-sm leading-relaxed text-crema/70" data-reveal>
      In ogni caso, la stessa esperienza Bottega N.8. Ti aspettiamo.
    </p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-4" data-reveal>
      <a href="tel:+39035297334" class="bg-ambra px-8 py-3 font-display text-sm uppercase tracking-[0.2em] text-antracite transition-transform duration-300 hover:-translate-y-0.5">
        Prenota
      </a>
      <a href="https://instagram.com/bottegan8" target="_blank" rel="noopener" class="border border-crema/30 px-8 py-3 font-display text-sm uppercase tracking-[0.2em] text-crema transition-colors duration-300 hover:border-ambra hover:text-ambra">
        @bottegan8
      </a>
    </div>

    <footer class="absolute bottom-6 w-full px-6">
      <p class="text-[10px] uppercase tracking-[0.3em] text-crema/35">
        Bottega N.8 · Via Clara Maffei 8, Bergamo · assapora condividi ripeti
      </p>
    </footer>
  </div>
</section>

<script>
  window.addEventListener('site:ready', () => {
    const gsap = (window as any).gsap
    const ScrollTrigger = (window as any).ScrollTrigger
    const reduced = (window as any).__reduced
    const path = document.querySelector('.infinity-path') as SVGPathElement | null
    if (!path) return

    const len = path.getTotalLength()
    path.style.strokeDasharray = String(len)
    path.style.strokeDashoffset = reduced ? '0' : String(len)

    if (!reduced) {
      gsap.to(path, {
        strokeDashoffset: 0,
        ease: 'none',
        scrollTrigger: { trigger: '#chiusura', start: 'top bottom', end: 'center 60%', scrub: true },
      })
    }
  })
</script>
