---
interface Props { id?: string; }
const { id = 'chiusura' } = Astro.props;
---

<section id={id} class="relative w-full overflow-hidden bg-nero pt-24 md:pt-32" data-st-section>
  <!-- Infinity loop motif -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.04]" aria-hidden="true">
    <svg class="h-full w-full" viewBox="0 0 1200 800" preserveAspectRatio="none">
      <path d="M600 100 C821 100 1000 279 1000 500 C1000 721 821 900 600 900 C379 900 200 721 200 500 C200 279 379 100 600 100 Z M600 180 C782 180 920 318 920 500 C920 682 782 820 600 820 C418 820 280 682 280 500 C280 318 418 180 600 180 Z" stroke="#DB934A" stroke-width="1.5" fill="none" />
    </svg>
  </div>

  <div class="relative z-10 mx-auto w-full max-w-4xl px-6 text-center">
    <!-- Infinity symbol -->
    <div class="mx-auto mb-12 text-ambra" data-reveal>
      <svg class="mx-auto h-20 w-20 md:h-24 md:w-24" viewBox="0 0 100 100" fill="none" aria-hidden="true">
        <path d="M50 20 C72.1 20 90 37.9 90 60 C90 82.1 72.1 100 50 100 C27.9 100 10 82.1 10 60 C10 37.9 27.9 20 50 20 Z M50 40 C66.6 40 80 53.4 80 70 C80 86.6 66.6 100 50 100 C33.4 100 20 86.6 20 70 C20 53.4 33.4 40 50 40 Z" stroke="currentColor" stroke-width="2.5" />
      </svg>
    </div>

    <h2 class="font-anton text-[clamp(2.2rem,6vw,4.5rem)] uppercase leading-[1.05] text-crema text-balance" data-reveal data-delay="0.15">
      In ogni caso, la stessa esperienza Bottega N.8
    </h2>
    <p class="mt-6 font-poppins text-[clamp(1.1rem,3vw,1.4rem)] font-medium uppercase tracking-widest text-ambra" data-reveal data-delay="0.3">
      autentica · curata · contemporanea
    </p>
    <p class="mt-6 font-poppins text-lg text-crema/60" data-reveal data-delay="0.4">Un viaggio di gusto, senza lasciare la città.</p>

    <div class="mt-12 flex flex-col items-center justify-center gap-4 sm:flex-row" data-reveal data-delay="0.5">
      <a href="tel:035297334" data-magnetic="0.3" class="lift-hover tap-press touch-target magnetic inline-flex w-full items-center justify-center gap-2 rounded-xl bg-ambra px-8 py-4 font-poppins text-base font-medium text-nero hover:bg-ambra/90 sm:w-auto"><span class="magnetic-inner">Prenota: 035 297 334</span></a>
      <a href="https://www.instagram.com/bottegan8/" target="_blank" rel="noopener noreferrer" data-magnetic="0.3" class="lift-hover tap-press touch-target magnetic inline-flex w-full items-center justify-center gap-2 rounded-xl border border-crema/25 px-8 py-4 font-poppins text-base font-medium text-crema hover:bg-crema/10 sm:w-auto"><span class="magnetic-inner">Segui @bottegan8</span></a>
    </div>

    <a href="#hero" class="group mt-16 inline-flex flex-col items-center gap-2 text-crema/40 transition-colors hover:text-ambra" data-reveal data-delay="0.6">
      <span class="font-poppins text-xs uppercase tracking-[0.3em]">Torna all'inizio</span>
      <svg class="h-5 w-5 animate-bounce" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 15l-6-6-6 6" /></svg>
    </a>
  </div>

  <!-- Newsletter CTA -->
  <div class="relative z-10 mx-auto mt-20 w-full max-w-xl px-6" data-reveal data-delay="0.2">
    <form id="newsletter-form" class="rounded-3xl border border-crema/15 bg-crema/[0.04] p-8 md:p-10 text-center" novalidate>
      <span class="font-poppins text-xs uppercase tracking-[0.3em] text-ambra">Resta in viaggio con noi</span>
      <h3 class="mt-3 font-anton text-2xl uppercase text-crema md:text-3xl">Novità e menù, prima di tutti</h3>
      <p class="mt-3 font-poppins text-sm text-crema/60">Nuovi piatti, stagioni e serate speciali. Direttamente nella tua inbox.</p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <label for="newsletter-email" class="sr-only">Indirizzo email</label>
        <input
          id="newsletter-email"
          name="email"
          type="email"
          required
          placeholder="La tua email"
          class="h-12 w-full flex-1 rounded-xl border border-crema/20 bg-transparent px-4 font-poppins text-crema placeholder:text-crema/40 focus:border-ambra focus:outline-none"
        />
        <button type="submit" class="tap-press touch-target inline-flex h-12 items-center justify-center rounded-xl bg-ambra px-6 font-poppins text-sm font-medium text-nero transition-colors hover:bg-ambra/90">
          Iscriviti
        </button>
      </div>
      <p id="newsletter-status" class="mt-4 hidden items-center justify-center gap-2 font-poppins text-sm text-ambra" role="status">
        <svg class="newsletter-check h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
        <span id="newsletter-status-text"></span>
      </p>
    </form>
  </div>

  <!-- Footer -->
  <footer class="relative z-10 mt-20 border-t border-crema/10 px-6 py-10">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-6 md:flex-row">
      <p class="text-center font-poppins text-sm text-crema/40 md:text-left">
        Bottega N.8 S.a.s. di Zhu Ruiliang — Via Clara Maffei 8, 24121 Bergamo
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        <a href="tel:035297334" class="touch-target font-poppins text-sm text-crema/40 transition-colors hover:text-ambra">035 297 334</a>
        <a href="https://www.instagram.com/bottegan8/" target="_blank" rel="noopener noreferrer" class="touch-target font-poppins text-sm text-crema/40 transition-colors hover:text-ambra">@bottegan8</a>
        <a href="https://deliveroo.it" target="_blank" rel="noopener noreferrer" class="touch-target font-poppins text-sm text-crema/40 transition-colors hover:text-ambra">Deliveroo</a>
        <a href="https://glovoapp.com" target="_blank" rel="noopener noreferrer" class="touch-target font-poppins text-sm text-crema/40 transition-colors hover:text-ambra">Glovo</a>
      </div>
    </div>
  </footer>
</section>

<script is:inline>
  window.addEventListener('site:ready', () => {
    if (window.lenis) {
      document.querySelectorAll('a[href="#hero"]').forEach((a) => {
        a.addEventListener('click', (e) => {
          e.preventDefault();
          window.lenis.scrollTo('#hero', { offset: 0, duration: 1.4 });
        });
      });
    }

    // Newsletter: validazione + feedback (nessun backend, mostra conferma)
    const form = document.getElementById('newsletter-form');
    const input = document.getElementById('newsletter-email');
    const status = document.getElementById('newsletter-status');
    const statusText = document.getElementById('newsletter-status-text');
    const check = document.querySelector('.newsletter-check');
    if (form && input && status && statusText) {
      function drawCheck() {
        if (!check) return;
        const path = check.querySelector('path');
        if (path) {
          const len = path.getTotalLength();
          path.style.strokeDasharray = len;
          path.style.strokeDashoffset = len;
          requestAnimationFrame(() => {
            path.style.transition = 'stroke-dashoffset 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.1s';
            path.style.strokeDashoffset = '0';
          });
        }
      }
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const email = input.value.trim();
        const valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
        status.classList.remove('hidden');
        status.classList.add('flex');
        check && (check.style.display = '');
        if (!valid) {
          statusText.textContent = 'Inserisci un indirizzo email valido.';
          check && (check.style.display = 'none');
          input.focus();
          return;
        }
        statusText.textContent = 'Grazie! Ti avviseremo ai prossimi arrivi.';
        input.value = '';
        drawCheck();
      });
    }
  });
</script>
