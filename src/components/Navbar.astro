---
// Navbar fissa: appare dall'alto dopo un certo scroll, con sfondo blur.
// Cambia contrasto in base alla sezione attiva (chiara/scura).
const links = [
  { href: '#storia', label: 'Storia' },
  { href: '#menu', label: 'Menu' },
  { href: '#tavolo-takeaway', label: 'Tavolo o Take Away' },
  { href: '#stampa', label: 'Stampa' },
  { href: '#dove-siamo', label: 'Dove Siamo' },
];
---

<header id="site-nav" class="fixed inset-x-0 top-0 z-[90] -translate-y-full">
  <nav class="flex items-center justify-between gap-4 px-5 py-4 md:px-10" aria-label="Navigazione principale">
    <a href="#hero" class="flex items-center gap-2 touch-target">
      <img id="nav-logo-dark" src="/logo.png" alt="Bottega N.8" class="h-9 w-auto" loading="eager" />
      <img id="nav-logo-light" src="/logo-light.png" alt="Bottega N.8" class="h-9 w-auto hidden" loading="eager" />
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {links.map((l) => (
        <a
          href={l.href}
          class="rounded-full px-4 py-2 font-poppins text-sm text-current transition-colors duration-300 hover:text-ambra"
        >{l.label}</a>
      ))}
    </div>

    <a
      href="tel:035297334"
      class="touch-target hidden items-center rounded-full bg-ambra px-5 py-2.5 font-poppins text-sm font-medium text-nero transition-colors hover:bg-ambra/90 sm:inline-flex"
    >Prenota</a>

    <!-- Mobile toggle -->
    <button
      type="button"
      id="nav-toggle"
      class="touch-target inline-flex h-11 w-11 items-center justify-center rounded-full text-current md:hidden"
      aria-label="Apri il menu"
      aria-expanded="false"
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <path id="icon-open" d="M4 7h16M4 12h16M4 17h16" />
        <path id="icon-close" class="hidden" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </nav>

  <!-- Mobile drawer -->
  <div id="nav-drawer" class="fixed inset-x-0 top-0 -z-10 hidden bg-antracite/95 px-6 pb-8 pt-24 backdrop-blur-md md:hidden" aria-hidden="true">
    <div class="flex flex-col gap-2">
      {links.map((l, i) => (
        <a
          href={l.href}
          class="nav-drawer-link touch-target rounded-xl px-4 py-3 font-anton text-2xl uppercase text-crema transition-colors hover:text-ambra"
        >{l.label}</a>
      ))}
      <a href="tel:035297334" class="nav-drawer-link mt-4 inline-flex items-center justify-center rounded-xl bg-ambra px-4 py-4 font-poppins font-medium text-nero">Prenota: 035 297 334</a>
    </div>
  </div>
</header>

<script is:inline>
  window.addEventListener('site:ready', () => {
    const nav = document.getElementById('site-nav');
    const toggle = document.getElementById('nav-toggle');
    const drawer = document.getElementById('nav-drawer');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');
    if (!nav || window.__reduced) return;
    const gsap = window.gsap;
    const ScrollTrigger = window.ScrollTrigger;

    let lastY = window.scrollY;

    // Appare dopo 300px, si nasconde scrollando giù, riappare scrollando su
    ScrollTrigger.create({
      start: 300,
      onUpdate: (self) => {
        const y = window.scrollY;
        const goingDown = y > lastY && y > 300;
        gsap.to(nav, {
          y: goingDown ? -120 : 0,
          duration: 0.4,
          ease: 'power2.out',
        });
        lastY = y;
      },
    });

    // Contrasto in base alla sezione attiva
    const darkSections = ['hero', 'filosofia', 'menu', 'dove-siamo', 'chiusura'];
    ScrollTrigger.create({
      start: 0,
      end: 'max',
      onUpdate: (self) => {
        const y = self.scroll();
        let active = 'hero';
        // Trova la sezione in cui ci troviamo
        for (const s of ['storia', 'filosofia', 'menu', 'tavolo-takeaway', 'dove-siamo', 'chiusura']) {
          const el = document.getElementById(s);
          if (el && el.offsetTop <= y + 120) active = s;
        }
        const isDark = darkSections.includes(active);
        // Navbar: testo chiaro su sezioni scure, scuro su sezioni chiare
        nav.style.color = isDark ? '#F8EADB' : '#222228';
        toggle.style.color = isDark ? '#F8EADB' : '#222228';
        // Logo: versione light (crema) su sezioni scure, dark (nero) su sezioni chiare
        const logoDark = document.getElementById('nav-logo-dark');
        const logoLight = document.getElementById('nav-logo-light');
        if (logoDark && logoLight) {
          logoDark.classList.toggle('hidden', isDark);
          logoLight.classList.toggle('hidden', !isDark);
        }
      },
    });

    // Mobile drawer
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      drawer.classList.toggle('hidden');
      drawer.setAttribute('aria-hidden', String(open));
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
      gsap.fromTo(drawer, { opacity: 0, y: -20 }, { opacity: 1, y: 0, duration: 0.35, ease: 'power2.out' });
    });

    document.querySelectorAll('.nav-drawer-link').forEach((a) => {
      a.addEventListener('click', () => {
        drawer.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      });
    });
  });
</script>
