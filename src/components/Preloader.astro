---
// Preloader brand: gauge circolare (stile Magic UI AnimatedCircularProgressBar)
// che si riempie con stroke-dashoffset mentre il logo fade-in, poi reveal verso l'alto.
// Il cerchio ruota come un "8/∞" ideale: numero % al centro.
---

<div id="preloader" class="fixed inset-0 z-[100] flex flex-col items-center justify-center gap-8 bg-antracite" aria-hidden="true">
  <!-- Logo sopra la gauge -->
  <img src="/logo-light.png" alt="" class="h-14 w-auto opacity-0 md:h-16" id="preloader-logo" loading="eager" />

  <!-- Gauge circolare con il numero % al centro -->
  <div class="relative flex size-44 items-center justify-center md:size-56">
    <svg
      id="preloader-gauge"
      class="size-full -rotate-90"
      viewBox="0 0 120 120"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <!-- Traccia di fondo -->
      <circle
        cx="60" cy="60" r="52"
        stroke="#2A2A32"
        stroke-width="3"
        stroke-linecap="round"
        fill="none"
      />
      <!-- Traccia ambra che si riempie -->
      <circle
        id="preloader-gauge-bar"
        cx="60" cy="60" r="52"
        stroke="#DB934A"
        stroke-width="3"
        stroke-linecap="round"
        fill="none"
        stroke-dasharray="326.7"
        stroke-dashoffset="326.7"
      />
    </svg>

    <!-- Contatore % esattamente al centro del cerchio -->
    <div class="absolute inset-0 flex items-center justify-center">
      <div class="relative inline-flex items-baseline font-anton text-5xl text-crema tabular-nums md:text-6xl" id="preloader-count-wrap">
        <span id="preloader-count">0</span>
        <span class="absolute left-full ml-0.5 font-poppins text-sm uppercase text-crema/50">%</span>
      </div>
    </div>
  </div>

  <!-- Motivo infinito (lemniscata di Bernoulli simmetrica) che si disegna sotto -->
  <svg id="preloader-eight" class="h-12 w-28 opacity-0 md:h-14 md:w-32" viewBox="0 0 200 80" fill="none" aria-hidden="true">
    <path
      id="preloader-eight-draw"
      d="M100 40 C70 40 40 12 40 40 C40 68 70 40 100 40 C130 40 160 12 160 40 C160 68 130 40 100 40 Z"
      stroke="#DB934A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
      stroke-dasharray="400" stroke-dashoffset="400"
    />
  </svg>

  <span class="font-poppins text-[10px] uppercase tracking-[0.4em] text-crema/50 opacity-0" id="preloader-tag">assapora · condividi · ripeti</span>
</div>

<script is:inline>
  function removePreloader() {
    const pre = document.getElementById('preloader');
    if (!pre || pre.dataset.done) return;
    pre.dataset.done = '1';
    pre.style.transition = 'opacity 0.4s ease, transform 0.6s ease';
    pre.style.opacity = '0';
    pre.style.transform = 'translateY(-100%)';
    setTimeout(() => pre.remove(), 650);
  }

  // Sicurezza: se qualunque cosa va storta (GSAP non carica, errore JS),
  // il preloader non deve MAI bloccare il sito. Timeout hard.
  const HARD_TIMEOUT = 5000;
  const hardTimer = setTimeout(removePreloader, HARD_TIMEOUT);

  function runPreloader() {
    const pre = document.getElementById('preloader');
    if (!pre) return;
    const gsap = window.gsap;
    // Fallback senza GSAP: mostra il sito subito.
    if (!gsap) { removePreloader(); return; }
    if (window.__reduced) { pre.remove(); clearTimeout(hardTimer); return; }

    const logo = document.getElementById('preloader-logo');
    const tag = document.getElementById('preloader-tag');
    const countEl = document.getElementById('preloader-count');
    const gaugeBar = document.getElementById('preloader-gauge-bar');
    const countObj = { val: 0 };
    const eight = document.getElementById('preloader-eight');
    const eightDraw = document.getElementById('preloader-eight-draw');
    const CIRC = 326.7; // 2 * PI * 52
    const EIGHT = 400;

    const setProgress = () => {
      if (countEl) countEl.textContent = String(Math.round(countObj.val));
      if (gaugeBar) gaugeBar.setAttribute('stroke-dashoffset', String(CIRC * (1 - countObj.val / 100)));
    };

    const tl = gsap.timeline({
      onComplete: () => {
        clearTimeout(hardTimer);
        removePreloader();
      },
    });

    tl.to(logo, { opacity: 1, duration: 0.5, ease: 'power2.out' })
      // L'8/infinito si disegna mentre la gauge si riempie
      .to(eight, { opacity: 1, duration: 0.4, ease: 'power2.out' }, '-=0.2')
      .to(eightDraw, { strokeDashoffset: 0, duration: 1.4, ease: 'power2.inOut' }, '-=0.4')
      .to(countObj, { val: 100, duration: 1.6, ease: 'power2.inOut', onUpdate: setProgress }, '-=0.1')
      .to(tag, { opacity: 1, duration: 0.5, ease: 'power2.out' }, '-=0.6')
      .to({}, { duration: 0.4 })
      .to([logo, tag, countEl, eight], { opacity: 0, y: -16, duration: 0.4, ease: 'power2.in' }, '-=0.2');
  }

  // GSAP è caricato dal modulo lenis-gsap.js (deferito). Se non pronto,
  // riprova al prossimo frame finché non compare (max ~2s), poi fallback.
  let tries = 0;
  function waitGsap() {
    if (window.gsap) { runPreloader(); return; }
    if (tries++ > 120) { removePreloader(); return; } // ~2s, poi mostra il sito
    requestAnimationFrame(waitGsap);
  }
  if (document.readyState === 'loading') {
    window.addEventListener('DOMContentLoaded', waitGsap);
  } else {
    waitGsap();
  }
</script>
