---
// Preloader v5: mask SVG UNICA (il video vive dentro la stessa maschera del
// tratto, niente clip-path CSS disallineati). Contatore legato al caricamento
// reale delle risorse critiche. Fallback anti-blocco 5s.
---

<div id="preloader" class="fixed inset-0 z-[100] flex items-center justify-center bg-antracite">
  <video
    class="preloader-video absolute inset-0 h-full w-full object-cover"
    style="opacity: 0.25"
    src="/photos/hero-video.mp4"
    autoplay muted loop playsinline preload="auto"
  ></video>
  <div class="absolute inset-0 bg-antracite/60"></div>

  <div class="preloader-core relative flex flex-col items-center">
    <!-- Un solo SVG: maschera + tratto + immagine video dentro il mask -->
    <svg viewBox="0 0 200 100" fill="none" class="h-48 w-auto sm:h-56" aria-hidden="true">
      <defs>
        <mask id="pp-inf-mask">
          <!-- il rettangolo bianco mostra tutto; il tratto nero "scava" il video
               che appare SOLO dove il tratto dell'infinito è già disegnato -->
          <rect x="0" y="0" width="200" height="100" fill="#fff" />
          <path
            class="inf-hole"
            d="M60 50 C60 22, 96 22, 100 50 C104 78, 140 78, 140 50 C140 22, 104 22, 100 50 C96 78, 60 78, 60 50 Z"
            stroke="#000" stroke-width="30" stroke-linecap="round" fill="none"
          />
        </mask>
      </defs>

      <!-- video dentro l'infinito, visibile solo attraverso la maschera -->
      <foreignObject x="0" y="0" width="200" height="100" mask="url(#pp-inf-mask)">
        <video xmlns="http://www.w3.org/1999/xhtml"
          src="/photos/hero-video.mp4"
          autoplay muted loop playsinline preload="auto"
          style="width: 200px; height: 100px; object-fit: cover; opacity: 0.9;"
        ></video>
      </foreignObject>

      <path
        class="inf-track"
        d="M60 50 C60 22, 96 22, 100 50 C104 78, 140 78, 140 50 C140 22, 104 22, 100 50 C96 78, 60 78, 60 50 Z"
        stroke="#DB934A" stroke-opacity="0.15" stroke-width="2" fill="none"
      />
      <path
        class="inf-stroke"
        d="M60 50 C60 22, 96 22, 100 50 C104 78, 140 78, 140 50 C140 22, 104 22, 100 50 C96 78, 60 78, 60 50 Z"
        stroke="#DB934A" stroke-width="2.5" stroke-linecap="round" fill="none"
      />
    </svg>

    <p class="mt-8 overflow-hidden"><span class="preloader-logo block font-display text-2xl uppercase tracking-[0.35em] text-crema">Bottega&nbsp;N.8</span></p>
    <p class="mt-2 text-[10px] uppercase tracking-[0.6em] text-ambra">Bergamo</p>
    <p class="preloader-count mt-6 font-mono text-xs tracking-widest text-crema/40">00</p>
  </div>
</div>

<style>
  .inf-stroke { stroke-dasharray: 1; stroke-dashoffset: 1; }
</style>

<script>
  function runPreloader() {
    const gsap = (window as any).gsap
    const reduced = (window as any).__reduced
    const pre = document.getElementById('preloader')
    if (!pre) return

    const countEl = pre.querySelector('.preloader-count') as HTMLElement

    if (reduced || !gsap) {
      countEl.textContent = '100'
      pre.remove()
      window.dispatchEvent(new CustomEvent('preloader:done'))
      return
    }

    // --- contatore REALE: progresso su risorse critiche (max 2s di attesa) ---
    let progress = 0
    const critical = [
      '/photos/hero-video.mp4',
      '/photos/logo-light.png',
    ]
    let loaded = 0
    const bump = () => {
      loaded++
      progress = Math.min(95, Math.round((loaded / (critical.length + 1)) * 95))
    }
    critical.forEach((src) => {
      const el = document.querySelector(`[src="${src}"]`) as HTMLVideoElement | HTMLImageElement | null
      if (!el) return progress = Math.max(progress, 40)
      if ((el as HTMLImageElement).complete) return bump()
      el.addEventListener('loadeddata', bump, { once: true })
      el.addEventListener('load', bump, { once: true })
      el.addEventListener('error', bump, { once: true })
    })

    const path = pre.querySelector('.inf-stroke') as SVGPathElement
    const len = path.getTotalLength()
    path.style.strokeDasharray = String(len)
    path.style.strokeDashoffset = String(len)

    const tl = gsap.timeline()
    tl.fromTo('.preloader-logo', { yPercent: 120 }, { yPercent: 0, duration: 0.8, ease: 'power4.out' }, 0.2)
      .to(path, { strokeDashoffset: 0, duration: 1.6, ease: 'power2.inOut' }, 0)
      // il contatore corre verso il progresso reale; completa a 100 a fine timeline
      .to({ v: 0 }, {
        v: 100,
        duration: 1.8,
        ease: 'power1.inOut',
        onUpdate: function () {
          const target = Math.round((this.targets()[0] as any).v)
          const shown = Math.min(target, Math.max(progress, Math.round(target * 0.6)))
          countEl.textContent = String(shown).padStart(2, '0')
        },
      }, 0)
      .add(() => { countEl.textContent = '100' })
      .to('.preloader-count', { opacity: 0, duration: 0.35 })
      .to('.preloader-core', { scale: 1.55, opacity: 0, filter: 'blur(6px)', duration: 0.85, ease: 'power3.in' }, '-=0.05')
      .to(pre.querySelector('.preloader-video'), { opacity: 0, scale: 1.08, duration: 0.85, ease: 'power2.in' }, '<')
      .to(pre, {
        opacity: 0,
        duration: 0.5,
        ease: 'power2.out',
        onComplete: () => pre.remove(),
      }, '-=0.3')
      .add(() => window.dispatchEvent(new CustomEvent('preloader:done')), '-=0.45')

    // fallback anti-blocco: se qualcosa va storto, chiudi comunque entro 5s
    setTimeout(() => {
      if (document.getElementById('preloader')) {
        gsap.to('#preloader', { opacity: 0, duration: 0.4, onComplete: () => { document.getElementById('preloader')?.remove(); window.dispatchEvent(new CustomEvent('preloader:done')) } })
      }
    }, 5000)
  }

  let started = false
  const start = () => { if (!started && document.readyState !== 'loading') { started = true; requestAnimationFrame(() => runPreloader()) } }
  if ((window as any).gsap) start()
  else document.addEventListener('site:ready', start)
  window.addEventListener('DOMContentLoaded', start)
</script>
