---
// Preloader v4: simbolo ∞ che si disegna attorno al logo, video dei ravioli
// visibile dentro il tratto dell'infinito (HTML video + clip-path CSS, niente
// foreignObject). Parte al window load reale: niente blocco se GSAP tarda.
---

<div id="preloader" class="fixed inset-0 z-[100] flex items-center justify-center bg-antracite">
  <!-- video di sfondo, molto scuro -->
  <video
    class="preloader-video absolute inset-0 h-full w-full object-cover"
    style="opacity: 0.25"
    src="/photos/hero-video.mp4"
    autoplay muted loop playsinline preload="auto"
  ></video>
  <div class="absolute inset-0 bg-antracite/60"></div>

  <div class="preloader-core relative flex flex-col items-center">
    <div class="inf-wrap relative" style="height: clamp(180px, 28vh, 256px); aspect-ratio: 2 / 1;">
      <svg viewBox="0 0 200 100" fill="none" class="absolute inset-0 h-full w-full" aria-hidden="true">
        <defs>
          <mask id="inf-mask">
            <path
              d="M60 50 C60 22, 96 22, 100 50 C104 78, 140 78, 140 50 C140 22, 104 22, 100 50 C96 78, 60 78, 60 50 Z"
              stroke="#fff" stroke-width="26" stroke-linecap="round" fill="none"
            />
          </mask>
        </defs>
        <path
          class="inf-track"
          d="M60 50 C60 22, 96 22, 100 50 C104 78, 140 78, 140 50 C140 22, 104 22, 100 50 C96 78, 60 78, 60 50 Z"
          stroke="#DB934A" stroke-opacity="0.15" stroke-width="2" fill="none"
        />
      </svg>
      <!-- video ritagliato dentro il tratto dell'infinito (CSS clip-path, robusto ovunque) -->
      <div class="inf-clip absolute inset-[-14%]" style="clip-path: path('M100 75 C100 33, 172 33, 200 75 C228 117, 300 117, 300 75 C300 33, 228 33, 200 75 C172 117, 100 117, 100 75 Z');">
        <video
          src="/photos/hero-video.mp4"
          autoplay muted loop playsinline preload="auto"
          style="position:absolute; left:-25%; top:-50%; width:150%; height:200%; object-fit:cover;"
        ></video>
        <div class="absolute inset-0" style="background: rgba(34,34,40,0.45);"></div>
      </div>
      <svg viewBox="0 0 200 100" fill="none" class="absolute inset-0 h-full w-full" aria-hidden="true">
        <path
          class="inf-stroke"
          d="M60 50 C60 22, 96 22, 100 50 C104 78, 140 78, 140 50 C140 22, 104 22, 100 50 C96 78, 60 78, 60 50 Z"
          stroke="#DB934A" stroke-width="2.5" stroke-linecap="round" fill="none"
        />
      </svg>
    </div>

    <p class="mt-8 overflow-hidden"><span class="preloader-logo block font-display text-2xl uppercase tracking-[0.35em] text-crema">Bottega&nbsp;N.8</span></p>
    <p class="mt-2 text-[10px] uppercase tracking-[0.6em] text-ambra">Bergamo</p>
    <p class="preloader-count mt-6 font-mono text-xs tracking-widest text-crema/40">00</p>
  </div>
</div>

<style>
  .inf-stroke {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
</style>

<script>
  function runPreloader() {
    const gsap = (window as any).gsap
    const reduced = (window as any).__reduced
    const pre = document.getElementById('preloader')
    if (!pre) return

    if (reduced || !gsap) {
      pre.remove()
      window.dispatchEvent(new CustomEvent('preloader:done'))
      return
    }

    const path = pre.querySelector('.inf-stroke') as SVGPathElement
    const len = path.getTotalLength()
    path.style.strokeDasharray = String(len)
    path.style.strokeDashoffset = String(len)

    const countEl = pre.querySelector('.preloader-count') as HTMLElement

    // il tratto dell'infinito si disegna; il logo sale; il contatore corre.
    // Poi tutto si espande e dissolve nell'hero.
    const tl = gsap.timeline()
    tl.fromTo('.preloader-logo', { yPercent: 120 }, { yPercent: 0, duration: 0.8, ease: 'power4.out' }, 0.2)
      .to(path, { strokeDashoffset: 0, duration: 1.8, ease: 'power2.inOut' }, 0)
      .to({ v: 0 }, {
        v: 100,
        duration: 2,
        ease: 'power2.inOut',
        onUpdate: function () {
          const v = Math.round((this.targets()[0] as any).v)
          countEl.textContent = String(v).padStart(2, '0')
        },
      }, 0)
      .to('.preloader-count', { opacity: 0, duration: 0.4 })
      .to('.preloader-core', { scale: 1.6, opacity: 0, filter: 'blur(6px)', duration: 0.9, ease: 'power3.in' }, '-=0.1')
      .to(pre.querySelector('.preloader-video'), { opacity: 0, scale: 1.08, duration: 0.9, ease: 'power2.in' }, '<')
      .to(pre, {
        opacity: 0,
        duration: 0.5,
        ease: 'power2.out',
        onComplete: () => pre.remove(),
      }, '-=0.35')
      .add(() => window.dispatchEvent(new CustomEvent('preloader:done')), '-=0.45')
  }

  // Attende che GSAP sia esposto dal layout, poi parte. Fallback: dopo 4s va comunque.
  let started = false
  const start = () => { if (!started) { started = true; runPreloader() } }
  if ((window as any).gsap) {
    start()
  } else {
    document.addEventListener('site:ready', start)
    setTimeout(start, 4000) // fallback anti-blocco
  }
</script>
