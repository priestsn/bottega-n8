---
// Vapor — tema ricorrente del vapore (nuvole/steam) per Bottega N.8.
// Basato sul pattern Aurora Background di Aceternity, ricolorato sul brand crema/ambra.
// Due modalità:
//   variant="divider"  → banda di nuvole che derivano, da inserire tra le sezioni
//   variant="steam"    → vapore che sale dal basso (per la Hero / sopra un piatto)
// tone:
//   light (default) → vapore chiaro crema/bianco, per sfondi scuri (nero/antracite)
//   dark            → vapore ambra/antracite soft, per sfondi chiari (crema)
// Props opzionali: height (px/rem), density (1-4), className.
interface Props {
  variant?: 'divider' | 'steam';
  tone?: 'light' | 'dark';
  height?: string;
  density?: number;
  className?: string;
}
const { variant = 'divider', tone = 'light', height = '', density = 3, className = '' } = Astro.props;
const n = Math.max(1, Math.min(4, density));
const blobs = Array.from({ length: n });
---

<div
  class={`vapor relative w-full overflow-hidden pointer-events-none select-none ${variant} ${tone} ${className}`}
  data-vapor={variant}
  data-tone={tone}
  style={height ? `height:${height}` : undefined}
  aria-hidden="true"
>
  <div class="vapor-layer vapor-layer-bg"></div>
  {blobs.map((_, i) => (
    <div class="vapor-blob" data-blob={i + 1}></div>
  ))}
</div>

<style is:global>
  /* ===== base ===== */
  .vapor { z-index: 5; }

  /* ===== layer aurora (sfondo a gradienti che fluttua) ===== */
  .vapor-layer-bg {
    position: absolute;
    inset: -10px;
    background-repeat: repeat;
    background-size: 300%, 200%;
    background-position: 50% 50%, 50% 50%;
    filter: blur(10px);
    will-change: background-position;
    animation: vapor-aurora 18s ease-in-out infinite alternate;
    opacity: 0.75;
  }
  /* Aurora chiara (su scuro) — crema/bianco */
  .vapor.tone-light .vapor-layer-bg {
    background-image:
      linear-gradient(100deg, #fff 0%, #fff 7%, transparent 10%, transparent 12%, #fff 16%),
      repeating-linear-gradient(100deg,
        rgba(248,234,219,0.55) 0%,
        rgba(255,255,255,0.35) 12%,
        rgba(248,234,219,0.5) 24%,
        rgba(255,255,255,0.3) 36%,
        rgba(248,234,219,0.55) 48%,
        rgba(219,147,74,0.18) 62%,
        rgba(248,234,219,0.5) 76%);
  }
  /* Aurora scura (su chiaro) — ambra/antracite soft */
  .vapor.tone-dark .vapor-layer-bg {
    background-image:
      linear-gradient(100deg, #fff 0%, #fff 7%, transparent 10%, transparent 12%, #fff 16%),
      repeating-linear-gradient(100deg,
        rgba(219,147,74,0.28) 0%,
        rgba(34,34,40,0.12) 14%,
        rgba(219,147,74,0.24) 30%,
        rgba(248,234,219,0.4) 46%,
        rgba(219,147,74,0.2) 60%,
        rgba(34,34,40,0.1) 78%);
  }
  @keyframes vapor-aurora {
    0%   { background-position: 50% 50%, 50% 50%; }
    100% { background-position: 350% 50%, 350% 50%; }
  }

  /* ===== blob di vapore (nuvole sfocate) ===== */
  .vapor-blob {
    position: absolute;
    border-radius: 9999px;
    filter: blur(24px);
    will-change: transform, opacity;
  }
  .vapor.tone-light .vapor-blob {
    background: radial-gradient(circle at 50% 50%,
      rgba(248,234,219,0.95) 0%,
      rgba(248,234,219,0.5) 45%,
      rgba(219,147,74,0.28) 75%,
      transparent 100%);
  }
  .vapor.tone-dark .vapor-blob {
    background: radial-gradient(circle at 50% 50%,
      rgba(219,147,74,0.55) 0%,
      rgba(219,147,74,0.28) 45%,
      rgba(34,34,40,0.14) 78%,
      transparent 100%);
  }

  /* ===== modalità DIVIDER (nuvole che derivano orizzontalmente) ===== */
  .vapor.divider { height: 10rem; }
  .vapor.divider .vapor-blob[data-blob="1"] {
    width: 22rem; height: 14rem; left: -6rem; top: 50%;
    transform: translateY(-50%);
    animation: vapor-drift-l 16s ease-in-out infinite alternate;
  }
  .vapor.divider .vapor-blob[data-blob="2"] {
    width: 26rem; height: 12rem; left: 20%; top: 50%;
    transform: translateY(-50%);
    animation: vapor-drift-r 20s ease-in-out infinite alternate;
  }
  .vapor.divider .vapor-blob[data-blob="3"] {
    width: 18rem; height: 13rem; left: 55%; top: 45%;
    transform: translateY(-50%);
    animation: vapor-drift-l 24s ease-in-out infinite alternate;
  }
  .vapor.divider .vapor-blob[data-blob="4"] {
    width: 30rem; height: 16rem; right: -8rem; top: 55%;
    transform: translateY(-50%);
    animation: vapor-drift-r 28s ease-in-out infinite alternate;
  }
  @keyframes vapor-drift-l {
    0%   { transform: translateY(-50%) translateX(0)      scale(1);   opacity: 0.8; }
    50%  { transform: translateY(-58%) translateX(40px)   scale(1.1); opacity: 1; }
    100% { transform: translateY(-48%) translateX(-20px)  scale(0.95); opacity: 0.6; }
  }
  @keyframes vapor-drift-r {
    0%   { transform: translateY(-50%) translateX(0)      scale(1);   opacity: 0.6; }
    50%  { transform: translateY(-44%) translateX(-30px)  scale(1.05); opacity: 0.95; }
    100% { transform: translateY(-56%) translateX(50px)   scale(0.9);  opacity: 0.55; }
  }

  /* ===== modalità STEAM (vapore che sale dal basso) ===== */
  .vapor.steam { height: 100%; }
  .vapor.steam .vapor-layer-bg {
    mask-image: linear-gradient(to top, #000 0%, transparent 90%);
    -webkit-mask-image: linear-gradient(to top, #000 0%, transparent 90%);
  }
  .vapor.steam .vapor-blob[data-blob="1"] {
    width: 10rem; height: 10rem; left: 22%; bottom: -4rem;
    animation: vapor-rise 9s ease-in-out infinite;
  }
  .vapor.steam .vapor-blob[data-blob="2"] {
    width: 12rem; height: 12rem; left: 45%; bottom: -6rem;
    animation: vapor-rise 12s ease-in-out 1.5s infinite;
  }
  .vapor.steam .vapor-blob[data-blob="3"] {
    width: 9rem; height: 9rem; left: 62%; bottom: -3rem;
    animation: vapor-rise 10s ease-in-out 3s infinite;
  }
  .vapor.steam .vapor-blob[data-blob="4"] {
    width: 14rem; height: 14rem; left: 8%; bottom: -8rem;
    animation: vapor-rise 13s ease-in-out 4.5s infinite;
  }
  @keyframes vapor-rise {
    0%   { transform: translateY(0) translateX(0) scale(0.6);  opacity: 0; }
    20%  { opacity: 0.9; }
    60%  { transform: translateY(-35vh) translateX(30px) scale(1.3); opacity: 0.7; }
    100% { transform: translateY(-70vh) translateX(-20px) scale(1.6); opacity: 0; }
  }

  @media (max-width: 640px) {
    .vapor.divider { height: 7rem; }
    .vapor.divider .vapor-blob[data-blob="4"] { display: none; }
  }
</style>
