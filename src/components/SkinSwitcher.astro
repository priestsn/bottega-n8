---
/*
 * SkinSwitcher — pannello temi per Bottega N.8.
 * Applica [data-skin] sull'<html> e persiste la scelta in localStorage.
 * Le skin sono definite in src/styles/global.css (override delle --color-*).
 */
const skins = [
  { id: "crema",  label: "Crema",   dot: "#F8EADB", ring: "#DB934A" },
  { id: "notte",  label: "Notte",   dot: "#15151b", ring: "#F2A65A" },
  { id: "ambra",  label: "Ambra",   dot: "#FFF3E0", ring: "#C2741E" },
  { id: "giada",  label: "Giada",   dot: "#EAF1EC", ring: "#7FA98B" },
];
---

<div class="skin-switcher" aria-label="Selettore tema">
  <button class="skin-toggle" type="button" aria-expanded="false" aria-controls="skin-panel">
    <span class="skin-toggle-label">Tema</span>
  </button>
  <div class="skin-panel" id="skin-panel" hidden>
    {skins.map((s) => (
      <button
        class="skin-option"
        type="button"
        data-skin={s.id}
        aria-pressed="false"
        title={s.label}
      >
        <span class="skin-swatch" style={`background:${s.dot};box-shadow:inset 0 0 0 2px ${s.ring}`}></span>
        <span class="skin-name">{s.label}</span>
      </button>
    ))}
  </div>
</div>

<style>
  .skin-switcher {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 90;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    font-family: var(--font-poppins);
  }
  .skin-toggle {
    border: 1px solid var(--color-ambra);
    background: var(--color-antracite);
    color: var(--color-crema);
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    backdrop-filter: blur(6px);
  }
  .skin-panel {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.5rem;
    border-radius: 14px;
    background: color-mix(in srgb, var(--color-antracite) 92%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-ambra) 50%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: 0 18px 40px -12px rgba(0,0,0,0.6);
  }
  .skin-panel[hidden] { display: none; }
  .skin-option {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.6rem;
    border: none;
    background: transparent;
    color: var(--color-crema);
    font-size: 0.85rem;
    border-radius: 8px;
    cursor: pointer;
    width: 100%;
  }
  .skin-option:hover { background: color-mix(in srgb, var(--color-ambra) 18%, transparent); }
  .skin-option[aria-pressed="true"] { outline: 2px solid var(--color-ambra); }
  .skin-swatch {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    flex: none;
  }
  @media (max-width: 640px) {
    .skin-toggle-label { display: none; }
    .skin-toggle::before { content: "✦"; }
  }
  @media (prefers-reduced-motion: reduce) {
    .skin-switcher * { transition: none !important; }
  }
</style>

<script is:inline>
  (function () {
    const KEY = "bottega8-skin";
    const root = document.documentElement;
    const toggle = document.querySelector(".skin-toggle");
    const panel = document.getElementById("skin-panel");
    const options = Array.from(document.querySelectorAll(".skin-option"));

    function apply(id, persist) {
      root.setAttribute("data-skin", id);
      options.forEach((o) => o.setAttribute("aria-pressed", String(o.dataset.skin === id)));
      if (persist) localStorage.setItem(KEY, id);
    }

    const saved = localStorage.getItem(KEY);
    apply(saved && options.some((o) => o.dataset.skin === saved) ? saved : "crema", false);

    toggle.addEventListener("click", () => {
      const open = panel.hasAttribute("hidden");
      panel.toggleAttribute("hidden", !open);
      toggle.setAttribute("aria-expanded", String(open));
    });

    options.forEach((o) =>
      o.addEventListener("click", () => {
        apply(o.dataset.skin, true);
        panel.setAttribute("hidden", "");
        toggle.setAttribute("aria-expanded", "false");
      })
    );

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !panel.hasAttribute("hidden")) {
        panel.setAttribute("hidden", "");
        toggle.setAttribute("aria-expanded", "false");
      }
    });
  })();
</script>
