---
// Firma del sito: un "8" che si disegna con lo scroll lungo il bordo destro,
// si chiude in ∞ alla fine e riporta all'inizio (loop del brand).
---

<svg
  id="scroll-eight"
  class="pointer-events-none fixed right-4 top-1/2 z-40 hidden h-16 w-auto -translate-y-1/2 opacity-70 md:block"
  viewBox="0 0 60 100"
  fill="none"
  aria-hidden="true"
>
  <path
    class="eight-path"
    d="M30 28 m-14 0 a14 20 0 1 0 28 0 a14 20 0 1 0 -28 0 M30 72 m-14 0 a14 20 0 1 0 28 0 a14 20 0 1 0 -28 0"
    stroke="#DB934A"
    stroke-width="2"
    stroke-linecap="round"
    fill="none"
  />
</svg>

<script>
  window.addEventListener('site:ready', () => {
    const gsap = (window as any).gsap
    const ScrollTrigger = (window as any).ScrollTrigger
    const reduced = (window as any).__reduced
    const path = document.querySelector('.eight-path') as SVGPathElement | null
    if (!path || reduced) return

    const len = path.getTotalLength()
    path.style.strokeDasharray = String(len)
    path.style.strokeDashoffset = String(len)

    // the 8 draws itself down the page, then completes into ∞ near the end
    // progress boost: garantisce che il tratto raggiunga il 100% prima della fine pagina
    gsap.fromTo(path, { strokeDashoffset: len }, {
      strokeDashoffset: 0,
      ease: 'none',
      scrollTrigger: {
        trigger: 'body',
        start: 'top top',
        end: 'bottom bottom',
        scrub: 0.6,
        onUpdate: (self: any) => {
          // clamp progress: a 90% di scroll il disegno è completo
          const boosted = Math.min(1, self.progress * 1.15)
          path.style.strokeDashoffset = String(len * (1 - boosted))
        },
      },
    })
  })
</script>
