---
// ScrollEight v3 (stile peaceput): sequenza scroll-driven di parole giganti.
// Ogni parola italiana ENORME è affiancata dal carattere cinese corrispondente,
// entrambi rivelati riga-per-riga dentro una maschera (clip + yPercent, stagger).
// L'ultima "frase piccola" che spezzava il ritmo è stata eliminata: il messaggio
// finale è ora l'accoppiata 手作 / FATTO A MANO, coerente col ritmo.
// Reduced motion: tutto statico visibile.
---

<section id="scrolleight" class="relative bg-antracite" data-scrolleight>
  <div class="se-stage flex h-[100svh] items-center overflow-hidden" data-se-stage>
    <div class="mx-auto w-full max-w-6xl px-6">
      {
        [
          { cn: '包', it: 'BAO', sub: 'soffio di vapore e cavolo fermentato' },
          { cn: '麵', it: 'NOODLES', sub: 'spaghetti freschi tirati a mano' },
          { cn: '餃', it: 'RAVIOLI', sub: 'pieghe chiuse a una a una' },
          { cn: '湯', it: 'BRODO', sub: 'cotte lentamente, mai di fretta' },
          { cn: '蒸', it: 'VAPORE', sub: 'il profumo che esce dalla porta' },
          { cn: '手作', it: 'FATTO A MANO', sub: 'ogni giorno, in bottega' },
        ].map((w, i) => (
          <div
            class={`se-word absolute inset-x-6 mx-auto max-w-6xl ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
            data-se-word={i}
            aria-hidden={i !== 0 ? 'true' : undefined}
          >
            <div class="flex items-end gap-5 sm:gap-10">
              {/* carattere cinese gigante: si riempie col progresso della parola */}
              <span
                class="cn-char select-none font-display leading-none text-antracite"
                class:list={[i === 0 ? '' : 'opacity-0']}
                style={`font-size: clamp(7rem, 24vw, 20rem); -webkit-text-stroke: 2px #DB934A;`}
                data-cn-char
              >
                {w.cn}
              </span>
              <span class="mb-4 hidden h-px flex-1 bg-ambra/30 sm:block" aria-hidden="true" />
            </div>
            <h2
              class="mt-2 font-display uppercase leading-[0.95] text-crema"
              style="font-size: clamp(2.8rem, 9vw, 7.5rem); letter-spacing: -0.04em;"
            >
              <span class="block overflow-hidden"><span class="it-line block" data-it-line>{w.it}</span></span>
            </h2>
            <p class="mt-3 text-xs uppercase tracking-[0.35em] text-ambra/80 sm:text-sm" data-sub-line>{w.sub}</p>
          </div>
        ))
      }
    </div>

    <!-- indicatore progresso verticale -->
    <div class="absolute right-5 top-1/2 hidden h-40 w-px -translate-y-1/2 bg-crema/15 md:block" aria-hidden="true">
      <div class="se-progress h-full w-full origin-top scale-y-0 bg-ambra" data-se-progress></div>
    </div>
  </div>
</section>

<script>
  window.addEventListener('site:ready', () => {
    const gsap = (window as any).gsap
    const ScrollTrigger = (window as any).ScrollTrigger
    const reduced = (window as any).__reduced
    const root = document.querySelector('[data-scrolleight]')
    if (!root) return

    const words = gsap.utils.toArray<HTMLElement>('[data-se-word]')
    const total = words.length
    if (!total) return

    if (reduced || !gsap) {
      // statico: solo la prima visibile
      words.forEach((w, i) => { (w as HTMLElement).style.opacity = i === 0 ? '1' : '0' })
      return
    }

    const progress = document.querySelector('[data-se-progress]')

    // timeline scrubbed: ogni parola entra (riga mascherata + char cinese che si accende)
    // vive da sola per un tratto, poi esce verso l'alto — stile peaceput KV.
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '[data-scrolleight]',
        start: 'top top',
        end: () => `+=${(total) * 70}%`,
        pin: true,
        scrub: 0.7,
        anticipatePin: 1,
        invalidateOnRefresh: true,
        onUpdate: (self: any) => {
          if (progress) gsap.set(progress, { scaleY: self.progress })
        },
      },
    })

    words.forEach((word, i) => {
      const itLine = word.querySelector('[data-it-line]')
      const subLine = word.querySelector('[data-sub-line]')
      const cnChar = word.querySelector('[data-cn-char]')

      const enter = gsap.timeline()
      enter.fromTo(itLine, { yPercent: 115 }, { yPercent: 0, duration: 0.55, ease: 'power4.out' })
        .fromTo(cnChar,
          { opacity: 0, scale: 0.92, filter: 'blur(10px)', webkitTextStrokeColor: 'transparent', color: '#DB934A' },
          { opacity: i === 0 ? 1 : 1, scale: 1, filter: 'blur(0px)', duration: 0.6, ease: 'power3.out' }, '<0.08')
        .fromTo(subLine, { yPercent: 100, opacity: 0 }, { yPercent: 0, opacity: 1, duration: 0.4, ease: 'power2.out' }, '<0.12')

      tl.add(() => {
        words.forEach((w, j) => gsap.to(w, { opacity: j === i ? 1 : 0, duration: 0.25, overwrite: 'auto' }))
        if (i > 0) enter.restart()
      }, i === 0 ? 0 : `+=${i * 0.35}`)

      if (i < total - 1) {
        tl.to(word, { opacity: 0, yPercent: -18, duration: 0.4, ease: 'power2.in' }, `+=0.85`)
          .set(word, { yPercent: 0 })
      }
    })

    // refresh dopo caricamento immagini/font
    window.addEventListener('load', () => ScrollTrigger.refresh())
  })
</script>
