---
import '../styles/global.css'
import '@fontsource/anton'
import '@fontsource/poppins/400.css'
import '@fontsource/poppins/500.css'

const { title = 'Bottega N.8 — Un viaggio di gusto, senza lasciare la città' } = Astro.props
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Bottega N.8, ristorante e take away a Bergamo. Artigianalità italiana e ispirazione orientale in chiave contemporanea. Via Clara Maffei 8." />
    <link rel="icon" type="image/svg+xml" href="/logo-light.png" />
    <meta property="og:title" content="Bottega N.8 — Bergamo" />
    <meta property="og:description" content="Artigianalità italiana e ispirazione orientale. Assapora, condividi, ripeti." />
    <meta property="og:image" content="/og-image.jpg" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Restaurant",
        "name": "Bottega N.8",
        "servesCuisine": "Asiatica contemporanea",
        "telephone": "+39 035 297334",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Via Clara Maffei 8",
          "postalCode": "24121",
          "addressLocality": "Bergamo",
          "addressCountry": "IT"
        },
        "priceRange": "€20–30"
      }
    </script>
  </head>
  <body>
    <slot />

    <script>
      import Lenis from 'lenis'
      import gsap from 'gsap'
      import { ScrollTrigger } from 'gsap/ScrollTrigger'

      gsap.registerPlugin(ScrollTrigger)

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      window.__reduced = reduced

      let lenis = null
      if (!reduced) {
        lenis = new Lenis()
        lenis.on('scroll', ScrollTrigger.update)
        gsap.ticker.add((t) => lenis!.raf(t * 1000))
        gsap.ticker.lagSmoothing(0)
      }
      // @ts-ignore expose for section scripts
      window.gsap = gsap
      window.ScrollTrigger = ScrollTrigger
      window.lenis = lenis

      // generic reveals: one trigger per [data-reveal-group], staggered children
      function initReveals() {
        document.querySelectorAll('[data-reveal-group]').forEach((group) => {
          const items = group.querySelectorAll('[data-reveal]')
          if (reduced || !items.length) {
            items.forEach((el) => ((el as HTMLElement).style.opacity = '1'))
            return
          }
          gsap.fromTo(
            items,
            { opacity: 0, y: 36 },
            {
              opacity: 1,
              y: 0,
              duration: 1,
              ease: 'power2.out',
              stagger: 0.14,
              scrollTrigger: { trigger: group, start: 'top 78%', once: true },
            }
          )
        })
      }

      initReveals()
      window.addEventListener('astro:page-load', initReveals)
      window.dispatchEvent(new CustomEvent('site:ready'))
    </script>
  </body>
</html>

<style is:global>
  html {
    background: #222228;
  }
</style>
