---
import '../styles/global.css';
import CustomCursor from '../components/CustomCursor.astro';
import Grain from '../components/Grain.astro';
import SkinSwitcher from '../components/SkinSwitcher.astro';
---

<!doctype html>
<html lang="it" data-skin="crema">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://bottegan8.it/" />
    <title>Bottega N.8 — Un viaggio di gusto, senza lasciare la città</title>
    <meta name="description" content="Bottega N.8: ristorante e take away a Bergamo. Artigianalità italiana e ispirazione orientale in chiave contemporanea. Via Clara Maffei 8, 24121 Bergamo." />
    <meta name="theme-color" content="#222228" />
    <meta property="og:title" content="Bottega N.8 — Un viaggio di gusto, senza lasciare la città" />
    <meta property="og:description" content="Ristorante e take away a Bergamo. Artigianalità italiana e ispirazione orientale contemporanea." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://bottegan8.it/" />
    <meta property="og:image" content="/og-image.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Bottega N.8 — Un viaggio di gusto, senza lasciare la città" />
    <meta name="twitter:description" content="Ristorante e take away a Bergamo. Artigianalità italiana e ispirazione orientale contemporanea." />
    <meta name="twitter:image" content="https://bottegan8.it/og-image.jpg" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Restaurant",
      "name": "Bottega N.8",
      "description": "Ristorante e take away che unisce artigianalità italiana e ispirazione orientale in chiave contemporanea.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Via Clara Maffei 8",
        "addressLocality": "Bergamo",
        "postalCode": "24121",
        "addressCountry": "IT"
      },
      "telephone": "+39 035 297 334",
      "servesCuisine": "Asiatica contemporanea",
      "priceRange": "€€",
      "image": "https://bottegan8.it/og-image.jpg",
      "hasMenu": "https://bottegan8.it/#menu",
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 45.6946631,
        "longitude": 9.6751172
      },
      "sameAs": [
        "https://www.instagram.com/bottegan8/"
      ]
    })} />
  </head>
  <body class="lenis lenis-smooth">
    <slot />
    <Grain />
    <CustomCursor />
    <SkinSwitcher />
    <script type="module">
      import '../scripts/lenis-gsap.js';
    </script>
  </body>
</html>
