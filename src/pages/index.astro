---
import Layout from '../layouts/Layout.astro';
import Preloader from '../components/Preloader.astro';
import Navbar from '../components/Navbar.astro';
import ScrollEight from '../components/ScrollEight.astro';
import Vapor from '../components/Vapor.astro';
import Hero from '../components/sections/Hero.astro';
import Storia from '../components/sections/Storia.astro';
import Marquee from '../components/Marquee.astro';
import Filosofia from '../components/sections/Filosofia.astro';
import Menu from '../components/sections/Menu.astro';
import Galleria from '../components/Galleria.astro';
import TavoloTakeaway from '../components/sections/TavoloTakeaway.astro';
import Stampa from '../components/sections/Stampa.astro';
import DoveSiamo from '../components/sections/DoveSiamo.astro';
import Chiusura from '../components/sections/Chiusura.astro';
---

<Layout>
  <Preloader />
  <Navbar />
  <ScrollEight />

  <Hero id="hero" />
  <!-- Divisore di vapore sul fondo scuro della Hero -->
  <div class="bg-nero" aria-hidden="true"><Vapor variant="divider" tone="light" density={3} /></div>
  <Storia id="storia" />
  <Marquee />
  <Filosofia id="filosofia" />
  <Menu id="menu" />
  <!-- Divisore di vapore tra Menu (scuro) e Galleria (scuro) -->
  <div class="bg-nero" aria-hidden="true"><Vapor variant="divider" tone="light" density={4} /></div>
  <Galleria />
  <TavoloTakeaway id="tavolo-takeaway" />
  <Stampa id="stampa" />
  <!-- Divisore di vapore tra Stampa (chiaro) e DoveSiamo (antracite) -->
  <div class="bg-crema" aria-hidden="true"><Vapor variant="divider" tone="dark" density={2} /></div>
  <DoveSiamo id="dove-siamo" />
  <Chiusura id="chiusura" />
</Layout>
